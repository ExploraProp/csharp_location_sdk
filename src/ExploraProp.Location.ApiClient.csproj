<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ExploraProp.Location.ApiClient</RootNamespace>
    <AssemblyName>ExploraProp.Location.ApiClient</AssemblyName>
    <PackageId>ExploraProp.Location.ApiClient</PackageId>
    <Version>0.1.0</Version>
    <Authors>ExploraProp</Authors>
    <Company>ExploraProp</Company>
    <Description>NSwag-generated OpenAPI client for the Location BC (WrapResponses; wire contract).</Description>
    <RepositoryUrl>https://github.com/ExploraProp/csharp_location_sdk</RepositoryUrl>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
      <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
